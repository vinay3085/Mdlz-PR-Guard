# ─── GitHub App ───────────────────────────────────────────────
# Your GitHub App's numeric App ID (found in App settings page)
GITHUB_APP_ID=

# Path to the PEM private key downloaded from the GitHub App settings page
GITHUB_PRIVATE_KEY_PATH=./certs/private_key.pem
# Alternative: paste the PEM content directly (takes precedence over the path above).
# Use this for cloud deployments (Databricks Apps, etc.) where file-based secrets are awkward.
# The value must be the full key including -----BEGIN RSA PRIVATE KEY----- header/footer.
GITHUB_PRIVATE_KEY_CONTENT=

# The webhook secret you set when creating/editing the GitHub App
GITHUB_WEBHOOK_SECRET=

# ─── LLM Configuration ────────────────────────────────────────
# Supported values: openai (default) | anthropic | databricks
LLM_PROVIDER=openai

# OpenAI — used when LLM_PROVIDER=openai
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — used when LLM_PROVIDER=anthropic
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Databricks Foundation Model APIs — used when LLM_PROVIDER=databricks
# DATABRICKS_HOST: your workspace host without https:// (e.g. adb-1234567890.18.azuredatabricks.net)
# DATABRICKS_TOKEN: a Personal Access Token (User Settings → Developer → Access tokens)
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Model name — must match the selected provider:
#   OpenAI:      gpt-4o (default) | gpt-4o-mini | o1 | o3-mini
#   Anthropic:   claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
#   Databricks:  databricks-meta-llama-3-3-70b-instruct (free Llama 3.3 70B)
#                databricks-dbrx-instruct | databricks-mixtral-8x7b-instruct
LLM_MODEL=gpt-4o

# ─── Application ──────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./mdlz_pr_guard.db

# ─── Prompts ──────────────────────────────────────────────────
PROMPTS_DIR=./prompts

# ─── Feature Flags ────────────────────────────────────────────
# By default only the PR change summary (file-by-file description)
# is added as a comment. Enable additional analyses individually.
#
# FEATURE_STATIC_ANALYSIS  — Semgrep code scanning (requires semgrep on PATH)
# FEATURE_SECRET_SCANNING  — Gitleaks secret detection (requires gitleaks on PATH)
# FEATURE_POLICY_CHECK     — Org policy rules (PR description length, ticket ref, etc.)
# FEATURE_LLM_FINDINGS     — LLM security analysis with detailed findings & risk rating
#
FEATURE_STATIC_ANALYSIS=false
FEATURE_SECRET_SCANNING=false
FEATURE_POLICY_CHECK=false
FEATURE_LLM_FINDINGS=false

# ─── LangSmith Tracing (optional) ─────────────────────────────
# Set to true to send all LLM call traces to LangSmith.
# Get your API key at https://smith.langchain.com/
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mdlz-pr-guard
